# Copy to .env.prod and fill in. Never commit the real file.
DB_NAME=electronic_home
DB_USER=electronic_home
DB_PASSWORD=change-me
# Token of the administrator that publishes receipts (X-Admin-Token). Empty: publishing is switched off.
RECEIPTS_ADMIN_TOKEN=change-me
# Signs the access tokens: at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Keys of the object storage (receipts and attachments of the chats). Letters, digits and - _ . + = / only;
# the secret is at least 16 characters. The application does not start without them.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-to-a-long-random-secret
